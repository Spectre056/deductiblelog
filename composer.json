{
    "name": "spectre056/deductiblelog",
    "description": "Nextcloud app for tracking household tax deductions",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "OCA\\DeductibleLog\\": "lib/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "nextcloud/ocp": "dev-stable33",
        "doctrine/dbal": "^3.8"
    },
    "autoload-dev": {
        "psr-4": {
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/",
            "OCA\\DeductibleLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "for f in $(find lib -name '*.php'); do php -l $f >/dev/null || exit 1; done && echo lint-ok"
    }
}
